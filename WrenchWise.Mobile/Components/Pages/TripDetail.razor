@page "/trip/{TripId:guid}"
@implements IDisposable
@inject WrenchWiseService WrenchWise
@inject NavigationManager Nav
@inject IDialogService DialogService

@if (_trip == null)
{
    <MudText Typo="Typo.h6">Trip not found</MudText>
    <MudButton OnClick="@(() => Nav.NavigateTo("trip-mode"))">Back to Trips</MudButton>
}
else
{
    <PageTitle>@_trip.Name</PageTitle>

    <div class="d-flex align-center mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("trip-mode"))" Class="mr-2" />
        <MudText Typo="Typo.h5">@_trip.Name</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="DeleteTrip" />
    </div>

    <MudGrid>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="1">
                <MudText Typo="Typo.h5" Color="Color.Primary">@_miles</MudText>
                <MudText Typo="Typo.caption" Class="opacity-70">Total Miles</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="1">
                <MudText Typo="Typo.h5" Color="Color.Error">@_totalCost.ToString("C0")</MudText>
                <MudText Typo="Typo.caption" Class="opacity-70">Total Cost</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="1">
                <MudText Typo="Typo.h5" Color="Color.Success">@_mpg.ToString("F1")</MudText>
                <MudText Typo="Typo.caption" Class="opacity-70">Avg MPG</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="1">
                <MudText Typo="Typo.h5" Color="Color.Info">@_days</MudText>
                <MudText Typo="Typo.caption" Class="opacity-70">Days</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mt-8 mb-4">Records</MudText>

    @if (_records.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="opacity-50">No records for this trip.</MudText>
    }
    else
    {
        <MudTimeline>
            @foreach (var rec in _records)
            {
                if (rec is WrenchWise.Shared.Models.FuelRecord f)
                {
                    <MudTimelineItem Color="Color.Info" Icon="@Icons.Material.Filled.LocalGasStation">
                        <MudCard Elevation="1">
                            <MudCardContent>
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.subtitle2">Fuel: @f.Station</MudText>
                                    <MudText Typo="Typo.subtitle2" Color="Color.Error">@f.TotalCost.ToString("C2")</MudText>
                                </div>
                                <MudText Typo="Typo.caption" Class="opacity-70">@f.FillDate.ToShortDateString() • @f.Gallons.ToString("F1") gal • Odo: @f.Odometer</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudTimelineItem>
                }
                else if (rec is WrenchWise.Shared.Models.MaintenanceRecord m)
                {
                    <MudTimelineItem Color="Color.Warning" Icon="@Icons.Material.Filled.Build">
                        <MudCard Elevation="1">
                            <MudCardContent>
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.subtitle2">Repair: @m.ServiceType</MudText>
                                    <MudText Typo="Typo.subtitle2" Color="Color.Error">@m.Cost.ToString("C2")</MudText>
                                </div>
                                <MudText Typo="Typo.caption" Class="opacity-70">@m.ServiceDate.ToShortDateString() • Odo: @m.Odometer</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudTimelineItem>
                }
                else if (rec is WrenchWise.Shared.Models.TripExpense e)
                {
                    <MudTimelineItem Color="Color.Tertiary" Icon="@Icons.Material.Filled.AttachMoney">
                        <MudCard Elevation="1">
                            <MudCardContent>
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.subtitle2">Expense: @e.Category</MudText>
                                    <MudText Typo="Typo.subtitle2" Color="Color.Error">@e.Amount.ToString("C2")</MudText>
                                </div>
                                <MudText Typo="Typo.caption" Class="opacity-70">@e.ExpenseDate.ToShortDateString() @(!string.IsNullOrEmpty(e.Notes) ? $"• {e.Notes}" : "")</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudTimelineItem>
                }
            }
        </MudTimeline>
    }
}

@code {
    [Parameter] public Guid TripId { get; set; }

    private WrenchWise.Shared.Models.Trip? _trip;
    private int _miles;
    private decimal _totalCost;
    private decimal _mpg;
    private int _days;
    private List<object> _records = new();

    protected override async Task OnInitializedAsync()
    {
        await WrenchWise.InitializeAsync();
        RefreshData();
        WrenchWise.Changed += HandleChanged;
    }

    private void HandleChanged()
    {
        RefreshData();
        InvokeAsync(StateHasChanged);
    }

    private void RefreshData()
    {
        _trip = WrenchWise.Trips.FirstOrDefault(x => x.Id == TripId);
        if (_trip == null) return;

        var endOdo = _trip.EndOdometer ?? WrenchWise.GetSuggestedOdometer(_trip.VehicleId);
        _miles = endOdo - _trip.StartOdometer;
        
        var endDate = _trip.EndDate ?? DateOnly.FromDateTime(DateTime.Today);
        _days = (endDate.DayNumber - _trip.StartDate.DayNumber) + 1;

        var fuels = WrenchWise.FuelRecords.Where(x => x.TripId == TripId).ToList();
        var maints = WrenchWise.MaintenanceRecords.Where(x => x.TripId == TripId).ToList();
        var exps = WrenchWise.TripExpenses.Where(x => x.TripId == TripId).ToList();

        var fuelCost = fuels.Sum(x => x.TotalCost);
        var maintCost = maints.Sum(x => x.Cost);
        var expCost = exps.Sum(x => x.Amount);
        _totalCost = fuelCost + maintCost + expCost;

        var totalGallons = fuels.Sum(x => x.Gallons);
        _mpg = totalGallons > 0 ? (decimal)_miles / totalGallons : 0;

        _records = fuels.Cast<object>()
            .Concat(maints.Cast<object>())
            .Concat(exps.Cast<object>())
            .OrderByDescending(x => x switch {
                WrenchWise.Shared.Models.FuelRecord f => f.FillDate,
                WrenchWise.Shared.Models.MaintenanceRecord m => m.ServiceDate,
                WrenchWise.Shared.Models.TripExpense e => e.ExpenseDate,
                _ => DateOnly.MinValue
            })
            .ToList();
    }

    private async Task DeleteTrip()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Delete Trip",
            "Are you sure you want to delete this trip? Associated fuel and expenses will NOT be deleted, but they will be unlinked.",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true && _trip != null)
        {
            await WrenchWise.DeleteTripAsync(_trip.Id);
            Nav.NavigateTo("trip-mode");
        }
    }

    public void Dispose() => WrenchWise.Changed -= HandleChanged;
}
